[options]
mode bmc
depth 17
expect pass

[engines]
smtbmc yices

[script]
read -formal _zkf_normshift.v
read -formal _zkf_rshift_sticky.v
read -formal _zkf_pack.v
read -formal zkf_pipe.v
read -formal _zkf_add_core.v
read -formal _zkf_pmul.v
read -formal zkf_fma.v
read -formal zkf_pack_ref.v
read -formal zkf_fma_ref.v
read -formal zkf_fma_eq.v
chparam -set WEXP 3 -set WMAN 5 -set STAGE_INPUT 1 -set STAGE_PRODUCT 1 -set STAGE_DECODE 1 -set STAGE_ALIGN 1 -set STAGE_NORMALIZE 1 -set STAGE_PACK 1 -set STAGE_OUTPUT 1 zkf_fma_eq
prep -top zkf_fma_eq

[files]
zkf/rtl/_zkf_normshift.v
zkf/rtl/_zkf_rshift_sticky.v
zkf/rtl/_zkf_pack.v
zkf/rtl/zkf_pipe.v
zkf/rtl/_zkf_add_core.v
zkf/rtl/_zkf_pmul.v
zkf/rtl/zkf_fma.v
proof/refs/zkf_pack_ref.v
proof/refs/zkf_fma_ref.v
proof/harness/zkf_fma_eq.v
